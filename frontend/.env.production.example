VITE_API_URL=/
VITE_AGENT_URL=/

# open spec: add-slash-skill-invocation — toggle slash / hash picker on MessageInput
# When true|1|yes|on: frontend shows a skill picker when the user types `/` or `#`
# at the start of the input. Pairs with AGENT_SLASH_SKILL_INVOCATION on the backend
# (both must be enabled for end-to-end force-call). Default false → no picker shown,
# no fetch to /api/skills/by-conversation, no impact on existing chat UX.
# VITE_SLASH_SKILL_INVOCATION=false

# 可选：Twemoji 资源根 URL（须以 / 结尾）。不设则使用 BASE_URL + /twemoji/14.0.2/assets/
# VITE_TWEMOJI_ASSETS_BASE=https://cdn.example.com/static/twemoji/14.0.2/assets/
